{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-foundation.local/contracts/foundation-v1-memory.json",
  "title": "Agent Foundation Memory contract",
  "type": "object",
  "required": ["namespace", "operations"],
  "properties": {
    "namespace": {"const": "/api/foundation/v1/memory"},
    "operations": {
      "type": "object",
      "required": [
        "propose",
        "review",
        "get-current",
        "get-revision",
        "list",
        "trace",
        "activation",
        "formation-status",
        "formation-queue",
        "recall",
        "feedback",
        "list-feedback-events",
        "transition-feedback-event",
        "reinforcement-diagnostic",
        "correct",
        "revoke",
        "restore",
        "capacity-plan",
        "rewrite-plan",
        "freeze-dreaming-window",
        "get-dreaming-window",
        "list-dreaming-windows",
        "dreaming-plan",
        "get-maintenance-plan",
        "list-maintenance-plans",
        "apply-maintenance",
        "rollback-maintenance",
        "operation-receipt"
      ],
      "properties": {
        "propose": {"const": "POST /entries"},
        "review": {"const": "POST /entries/{memory_id}/review"},
        "get-current": {"const": "GET /entries/{memory_id}"},
        "get-revision": {"const": "GET /entries/{memory_id}/revisions/{revision}"},
        "list": {"const": "GET /entries"},
        "trace": {"const": "GET /entries/{memory_id}/trace"},
        "activation": {"const": "GET /entries/{memory_id}/activation"},
        "formation-status": {"const": "GET /formation/status"},
        "formation-queue": {"const": "GET /formation/queue"},
        "recall": {"const": "POST /recall"},
        "feedback": {"const": "POST /entries/{memory_id}/feedback"},
        "list-feedback-events": {"const": "GET /feedback-events"},
        "transition-feedback-event": {"const": "POST /feedback-events/{event_id}/transition"},
        "reinforcement-diagnostic": {"const": "GET /entries/{memory_id}/reinforcement-diagnostic"},
        "correct": {"const": "POST /entries/{memory_id}/correct"},
        "revoke": {"const": "POST /entries/{memory_id}/revoke"},
        "restore": {"const": "POST /entries/{memory_id}/restore"},
        "capacity-plan": {"const": "POST /maintenance/capacity-plan"},
        "rewrite-plan": {"const": "POST /maintenance/rewrite-plan"},
        "freeze-dreaming-window": {"const": "POST /maintenance/dreaming-windows"},
        "get-dreaming-window": {"const": "GET /maintenance/dreaming-windows/{window_id}"},
        "list-dreaming-windows": {"const": "GET /maintenance/dreaming-windows"},
        "dreaming-plan": {"const": "POST /maintenance/dreaming-plan"},
        "get-maintenance-plan": {"const": "GET /maintenance/plans/{plan_id}"},
        "list-maintenance-plans": {"const": "GET /maintenance/plans"},
        "apply-maintenance": {"const": "POST /maintenance/apply"},
        "rollback-maintenance": {"const": "POST /maintenance/rollback"},
        "operation-receipt": {"const": "GET /operations/{operation_id}"}
      }
    }
  }
}
